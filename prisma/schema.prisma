datasource db {
    provider = "postgresql"
}
generator client {
    provider = "prisma-client"
    output = "./generated"
}

model User {
    id              Int         @id @default(autoincrement())
    createdAt       DateTime    @default(now())
    name            String
    attending       Boolean
    favoriteFood    FavoriteFood? 
}

model FavoriteFood {
    id          Int         @id @default(autoincrement())
    createdAt   DateTime    @default(now())
    food        String
    UserId      Int         @unique()      
    user        User        @relation(fields: [UserId], references: [id], onDelete: Cascade)
}